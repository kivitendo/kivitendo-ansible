[Unit]
Description=kivitendo background jobs server
Requires=postgresql.service
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=forking
User={{ kivitendo_web_user }}
Group={{ kivitendo_web_group }}
WorkingDirectory={{ kivitendo_install_dir }}
ExecStart={{ kivitendo_install_dir }}/scripts/task_server.pl start
ExecStop={{ kivitendo_install_dir }}/scripts/task_server.pl stop
ExecReload={{ kivitendo_install_dir }}/scripts/task_server.pl restart
Restart=always
RestartSec=10s
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
